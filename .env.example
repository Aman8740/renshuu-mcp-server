# Copy this file to .env and fill in your real key. Never commit .env.

# Required: your renshuu API key (renshuu site settings > API).
RENSHUU_API_KEY=

# Transport: "stdio" for local/dev use (e.g. Claude Desktop local command),
# "http" for a publicly hosted server you'll add as a custom connector.
TRANSPORT=stdio

# Only used when TRANSPORT=http
PORT=3000

# Client-side safety cap on requests/day, matching renshuu's documented
# ~500/day limit (confirmed via the live /profile response's api_usage field).
# RENSHUU_DAILY_LIMIT=500
