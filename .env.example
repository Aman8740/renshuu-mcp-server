# Copy this file to .env and fill in your real key. Never commit .env.

# Required: your renshuu API key (renshuu site settings > API).
RENSHUU_API_KEY=

# Transport: "stdio" for local/dev use (e.g. Claude Desktop local command),
# "http" for a publicly hosted server you'll add as a custom connector.
TRANSPORT=stdio

# Only used when TRANSPORT=http
PORT=3000

# Client-side safety cap on requests/day, matching renshuu's documented
# ~500/day limit (confirmed via the live /profile response's api_usage field).
# RENSHUU_DAILY_LIMIT=500

# Required for OAuth (lets each Claude user connect with their own renshuu
# key via a login page, instead of everyone sharing RENSHUU_API_KEY above).
# Generate with: openssl rand -base64 32
# Treat this like a password — if it changes, every connected user has to
# reconnect the connector (all previously issued tokens stop decrypting).
OAUTH_ENCRYPTION_KEY=

# Optional — only needed if auto-detecting the public URL from request
# headers ever picks the wrong value (e.g. behind a non-standard proxy).
# Not needed on a normal Vercel deployment.
# OAUTH_ISSUER_URL=https://renshuu-mcp-server.vercel.app
